@{
    ViewData["Title"] = "About";
}

<h1 class="h3 mb-4">About TrailKeeper</h1>

<div class="row">
    <div class="col-lg-8">
        <p>
            TrailKeeper is a small catalog of hiking trails. Every trail belongs to a mountain region
            and has a difficulty level, so routes are easy to compare before you head out.
        </p>
        <h2 class="h5 mt-4">What you can do</h2>
        <ul>
            <li>Browse all trails and open their details without an account.</li>
            <li>Register and log in to add your own trails.</li>
            <li>Edit or delete only the trails you created.</li>
        </ul>
    </div>
</div>