@model TrailListItemViewModel

<div class="card h-100 shadow-sm">
    <div class="card-body">
        <h5 class="card-title">@Model.Name</h5>
        <p class="card-text text-muted mb-2">@Model.RegionName</p>
        <span class="badge bg-secondary">@Model.DifficultyName</span>
        <ul class="list-unstyled small mt-3 mb-0">
            <li>Length: @Model.LengthKm.ToString("0.0") km</li>
            <li>Duration: @Model.DurationHours.ToString("0.0") h</li>
        </ul>
    </div>
    <div class="card-footer bg-transparent d-flex gap-2">
        <a class="btn btn-sm btn-outline-primary" asp-controller="Trails" asp-action="Details" asp-route-id="@Model.Id">Details</a>
        <a class="btn btn-sm btn-outline-secondary" asp-controller="Trails" asp-action="Edit" asp-route-id="@Model.Id">Edit</a>
        <a class="btn btn-sm btn-outline-danger" asp-controller="Trails" asp-action="Delete" asp-route-id="@Model.Id">Delete</a>
    </div>
</div>
