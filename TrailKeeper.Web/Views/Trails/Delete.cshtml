@model TrailDeleteViewModel
@{
    ViewData["Title"] = "Delete trail";
}

<div class="card border-danger shadow-sm">
    <div class="card-body">
        <h1 class="h4 card-title text-danger">Delete trail</h1>
        <p class="mb-0">
            Are you sure you want to delete <strong>@Model.Name</strong> (@Model.RegionName)?
            This cannot be undone.
        </p>
    </div>
    <div class="card-footer bg-transparent">
        <form asp-action="Delete" asp-route-id="@Model.Id" method="post" class="d-flex gap-2">
            <button type="submit" class="btn btn-danger">Yes, delete</button>
            <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">Cancel</a>
        </form>
    </div>
</div>