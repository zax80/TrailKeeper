@model TrailFormViewModel
@{
    ViewData["Title"] = "Edit trail";
    var id = ViewContext.RouteData.Values["id"];
}

<h1 class="h3 mb-4">Edit trail</h1>

<div class="row">
    <div class="col-lg-8">
        <form asp-action="Edit" asp-route-id="@id" method="post">
            <partial name="_TrailForm" model="Model" />
            <button type="submit" class="btn btn-success">Save changes</button>
            <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@id">Cancel</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
